{
  "name": "review-notes-extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Chromium MV3 extension for timestamped review notes, annotations and screenshots on videos and web pages, with an MCP companion.",
  "license": "MIT",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && vitest run",
    "test:e2e": "npm run build && playwright test",
    "schema": "node scripts/gen-schema.mjs",
    "companion": "node dist/companion/cli.js serve",
    "prepare": "npm run build"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/chrome": "^0.3.7",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "fake-indexeddb": "^6.2.8",
    "happy-dom": "^21.0.4",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "bin": {
    "review-notes-companion": "dist/companion/cli.js"
  },
  "engines": {
    "node": ">=20"
  }
}
